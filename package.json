{
  "name": "betting-ny",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "fetch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Fetch-OpenSources.ps1",
    "xg": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Fetch-UnderstatXg.ps1",
    "fpl": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Fetch-FplAvailability.ps1",
    "clubelo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Fetch-ClubElo.ps1",
    "lineups": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Fetch-Lineups.ps1",
    "lineup": "node scripts/fetch-match-lineup.mjs",
    "players": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Fetch-PlayerStats.ps1",
    "odds": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Fetch-OddsApi.ps1",
    "odds:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Local-OddsRefresh.ps1",
    "oddsportal": "node scripts/fetch-oddsportal.mjs",
    "pro": "node scripts/pro-layer.mjs",
    "tune": "node scripts/tune-league-models.mjs",
    "scan": "node scripts/daily-scanner.mjs",
    "audit": "node scripts/audit-leagues.mjs",
    "site": "node scripts/build-static-site.mjs && npx -y wrangler@4 pages deploy site --project-name newbetting --branch main --commit-dirty=true",
    "ledger": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Update-TipsLedger.ps1",
    "store": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Update-BettingStore.ps1 -SkipDownload",
    "venues": "node scripts/fetch-venues.mjs",
    "weather": "node scripts/fetch-weather.mjs",
    "weather:history": "node scripts/fetch-weather.mjs --history",
    "players:impact": "node scripts/fetch-player-impact.mjs",
    "leagues": "node scripts/fetch-extra-leagues.mjs",
    "stryktips": "node scripts/fetch-stryktipset.mjs",
    "history": "node scripts/fetch-history.mjs",
    "lardomar": "node scripts/analyze-learnings.mjs",
    "stil": "node scripts/analyze-style-matchups.mjs",
    "stil:hamta": "node scripts/fetch-team-style.mjs",
    "lardomar:modell": "node scripts/learnings-model.mjs && node scripts/analyze-learnings.mjs",
    "matcher": "node scripts/export-league-matches.mjs",
    "domare": "node scripts/fetch-referees.mjs",
    "domare:fotmob": "node scripts/fetch-referees-fotmob.mjs",
    "felanalys": "node scripts/tips-felanalys.mjs",
    "trupper": "node scripts/fetch-squads.mjs",
    "trupper:kontroll": "node scripts/verify-squads-tm.mjs",
    "spelare": "node scripts/fetch-player-stats-fotmob.mjs",
    "elvor": "node scripts/fetch-startelvor.mjs",
    "sync": "npm run fetch && npm run store",
    "gui": "node gui/server.mjs",
    "start": "node gui/server.mjs",
    "test": "playwright test",
    "test:pw": "playwright test",
    "test:e2e": "playwright test --project=e2e-screenshots",
    "test:players": "playwright test --project=player-stats",
    "test:unit": "playwright test --project=unit-data",
    "test:lib": "playwright test --project=lib-units",
    "report:tips": "playwright test --project=e2e-screenshots -g \"screenshot: lokal tipsrapport\"",
    "trello:close-done": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Close-TrelloDone.ps1",
    "ralph": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ralph-iterate.ps1",
    "site:build": "node scripts/build-static-site.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0"
  }
}
